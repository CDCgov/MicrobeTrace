      "timeoutMs": 300000,
      "files": [
        {
          "name": "LargeDataSet_Test_sequences_node.csv",
          "datatype": "node",
          "field1": "id"
        },
        {
          "name": "LargeDataSet_Test_sequences_Distedgelist.csv",
          "datatype": "link",
          "field1": "ID1",
          "field2": "ID2",
          "field3": "Distance"
        }
      ],
      "preLaunch": {
        "metric": "tn93",
        "threshold": 0.015,
        "defaultView": "2D Network"
      },
      "expected": {
        "nodes": 1600,
        "totalLinks": 118282,
        "visibleLinks": 537
      },
      "interactions": {
        "thresholdDuringChange": 0.01,
        "restoreThreshold": 0.015,
        "restoreTimeoutMs": 120000
      },
      "metadata": {
        "source": "Committed Cypress fixture set",
        "distancePath": "real-distance-edge-list",
        "threshold": 0.015
      }
    },
    {
