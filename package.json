{
  "name": "MicrobeTrace",
  "version": "2.2.1",
  "scripts": {
    "ng": "ng",
    "start": "ng serve -c development",
    "demo:partner-embed": "node scripts/serve-partner-embed-demo.js",
    "start:local-cypress": "ng serve -c development --host 127.0.0.1 --port 4210 --watch=false --live-reload=false",
    "prebuild": "node scripts/update-version.js",
    "tomcat:setup": "bash scripts/tomcat/setup-local-tomcat.sh",
    "tomcat:deploy": "bash scripts/tomcat/deploy-war-local.sh",
    "tomcat:start": "bash scripts/tomcat/start-local-tomcat.sh",
    "tomcat:stop": "bash scripts/tomcat/stop-local-tomcat.sh",
    "tomcat:smoke": "bash scripts/tomcat/run-war-smoke.sh",
    "tomcat:smoke:win": "scripts\\tomcat\\run-war-smoke.cmd",
    "build": "ng build",
    "verify:dist": "node scripts/verify-production-artifacts.js && npm run verify:embed-security",
    "verify:embed-security": "node scripts/validate-partner-allowlist.js",
    "test": "ng test",
    "test:embed-security": "node --test scripts/embed-security.test.js",
    "lint": "ng lint",
    "e2e": "start-server-and-test start:local-cypress http://127.0.0.1:4210 e2e:journeys:all:local:chrome",
    "e2e:journeys:flows": "npx cypress run --headless --browser electron --spec \"cypress/e2e/ingestion/files-ui.cy.ts,cypress/e2e/journeys/flows/*.cy.ts\"",
    "e2e:journeys:view-state": "npx cypress run --headless --browser electron --spec \"cypress/e2e/view-state/twod-view.cy.ts,cypress/e2e/view-state/crosstab-view.cy.ts,cypress/e2e/view-state/crosstab-export.cy.ts,cypress/e2e/view-state/aggregate-view.cy.ts\"",
    "e2e:journeys:contracts": "npx cypress run --headless --browser electron --env contractMode=1 --spec \"cypress/e2e/journeys/flows/behavior-contracts.cy.ts,cypress/e2e/journeys/flows/filtering-newick.contract.cy.ts,cypress/e2e/journeys/flows/filtering-oracle.contract.cy.ts,cypress/e2e/journeys/flows/nearest-neighbor-angulartesting.contract.cy.ts,cypress/e2e/journeys/flows/post-launch-distance-metric-switch.cy.ts\"",
    "e2e:journeys:all": "npm run e2e:journeys:flows && npm run e2e:journeys:view-state && npm run e2e:journeys:contracts",
    "e2e:journeys:flows:local": "npx cypress run --headless --browser electron --config baseUrl=http://127.0.0.1:4210 --spec \"cypress/e2e/ingestion/files-ui.cy.ts,cypress/e2e/journeys/flows/*.cy.ts\"",
    "e2e:journeys:view-state:local": "npx cypress run --headless --browser electron --config baseUrl=http://127.0.0.1:4210 --spec \"cypress/e2e/view-state/twod-view.cy.ts,cypress/e2e/view-state/crosstab-view.cy.ts,cypress/e2e/view-state/crosstab-export.cy.ts,cypress/e2e/view-state/aggregate-view.cy.ts\"",
    "e2e:journeys:contracts:local": "npx cypress run --headless --browser electron --config baseUrl=http://127.0.0.1:4210 --env contractMode=1 --spec \"cypress/e2e/journeys/flows/behavior-contracts.cy.ts,cypress/e2e/journeys/flows/filtering-newick.contract.cy.ts,cypress/e2e/journeys/flows/filtering-oracle.contract.cy.ts,cypress/e2e/journeys/flows/nearest-neighbor-angulartesting.contract.cy.ts,cypress/e2e/journeys/flows/post-launch-distance-metric-switch.cy.ts\"",
    "e2e:journeys:spec:local": "npx cypress run --headless --browser electron --config baseUrl=http://127.0.0.1:4210",
    "e2e:journeys:all:local": "npm run e2e:journeys:flows:local && npm run e2e:journeys:view-state:local && npm run e2e:journeys:contracts:local",
    "e2e:journeys:flows:local:chrome": "npx cypress run --headless --browser chrome --config baseUrl=http://127.0.0.1:4210 --spec \"cypress/e2e/ingestion/files-ui.cy.ts,cypress/e2e/journeys/flows/*.cy.ts\"",
    "e2e:journeys:view-state:local:chrome": "npx cypress run --headless --browser chrome --config baseUrl=http://127.0.0.1:4210 --spec \"cypress/e2e/view-state/twod-view.cy.ts,cypress/e2e/view-state/crosstab-view.cy.ts,cypress/e2e/view-state/crosstab-export.cy.ts,cypress/e2e/view-state/aggregate-view.cy.ts\"",
    "e2e:journeys:contracts:local:chrome": "npx cypress run --headless --browser chrome --config baseUrl=http://127.0.0.1:4210 --env contractMode=1 --spec \"cypress/e2e/journeys/flows/behavior-contracts.cy.ts,cypress/e2e/journeys/flows/filtering-newick.contract.cy.ts,cypress/e2e/journeys/flows/filtering-oracle.contract.cy.ts,cypress/e2e/journeys/flows/nearest-neighbor-angulartesting.contract.cy.ts,cypress/e2e/journeys/flows/post-launch-distance-metric-switch.cy.ts\"",
    "e2e:journeys:all:local:chrome": "npm run e2e:journeys:flows:local:chrome && npm run e2e:journeys:view-state:local:chrome && npm run e2e:journeys:contracts:local:chrome",
    "e2e:perf:local": "npx cypress run --headless --browser chrome --config baseUrl=http://127.0.0.1:4210,trashAssetsBeforeRuns=false --env perfMode=1 --spec \"cypress/e2e/performance/**/*.perf.cy.ts\"",
    "e2e:perf": "start-server-and-test start:local-cypress http://127.0.0.1:4210 e2e:perf:local",
    "e2e:perf:large:local": "npx cypress run --headless --browser chrome --config baseUrl=http://127.0.0.1:4210,trashAssetsBeforeRuns=false --env perfMode=1,perfLarge=1 --spec \"cypress/e2e/performance/*large*.perf.cy.ts\"",
    "e2e:perf:large": "start-server-and-test start:local-cypress http://127.0.0.1:4210 e2e:perf:large:local",
    "e2e:perf:stress:local": "npx cypress run --headless --browser chrome --config baseUrl=http://127.0.0.1:4210,trashAssetsBeforeRuns=false --env perfMode=1,perfStress=1 --spec \"cypress/e2e/performance/*stress*.perf.cy.ts\"",
    "e2e:perf:stress": "start-server-and-test start:local-cypress http://127.0.0.1:4210 e2e:perf:stress:local",
    "e2e:perf:real:local": "npx cypress run --headless --browser chrome --config baseUrl=http://127.0.0.1:4210,trashAssetsBeforeRuns=false --env perfMode=1,perfRealSamples=1 --spec \"cypress/e2e/performance/real-samples.perf.cy.ts\"",
    "e2e:perf:real": "start-server-and-test start:local-cypress http://127.0.0.1:4210 e2e:perf:real:local",
    "e2e:perf:realistic:local": "npx cypress run --headless --browser chrome --config baseUrl=http://127.0.0.1:4210,trashAssetsBeforeRuns=false --env perfMode=1,perfRealisticSamples=1 --spec \"cypress/e2e/performance/realistic-samples.perf.cy.ts\"",
    "e2e:perf:realistic": "start-server-and-test start:local-cypress http://127.0.0.1:4210 e2e:perf:realistic:local",
    "e2e:perf:dunes:local": "npx cypress run --headless --browser chrome --config baseUrl=http://127.0.0.1:4210,trashAssetsBeforeRuns=false --env perfMode=1,perfDunesSamples=1 --spec \"cypress/e2e/performance/dunes-samples.perf.cy.ts\"",
    "e2e:perf:dunes": "start-server-and-test start:local-cypress http://127.0.0.1:4210 e2e:perf:dunes:local",
    "e2e:perf:summarize": "node scripts/summarize-performance-runs.js --min-samples 5",
    "e2e:perf:budgets:propose": "node scripts/propose-performance-budgets.js --min-samples 5",
    "e2e:perf:budgets:check": "node scripts/check-performance-budgets.js",
    "e2e:perf:budgets:check:enforce": "node scripts/check-performance-budgets.js --enforce",
    "e2e:perf:report": "node scripts/package-performance-report.js",
    "e2e:perf:ci": "npm run e2e:perf && npm run e2e:perf:summarize && npm run e2e:perf:budgets:check && npm run e2e:perf:report",
    "e2e:perf:collect": "node scripts/run-performance-baseline.js",
    "e2e:newick-parity:capture:local": "npx cypress run --headless --browser chrome --config baseUrl=http://127.0.0.1:4210,trashAssetsBeforeRuns=false --env parityMode=1 --spec \"cypress/e2e/performance/newick-parity-capture.perf.cy.ts\"",
    "e2e:newick-parity:compare": "node scripts/compare-newick-parity.js",
    "e2e:newick-tree:capture:local": "npx cypress run --headless --browser chrome --config baseUrl=http://127.0.0.1:4210,trashAssetsBeforeRuns=false --env treeValidationMode=1 --spec \"cypress/e2e/performance/newick-tree-capture.perf.cy.ts\"",
    "e2e:newick-tree:compare": "node scripts/compare-newick-trees.js",
    "test:newick-validation": "node --test scripts/newick-validation.test.js",
    "fixtures:performance:dunes": "node scripts/generate-dunes-performance-fixtures.js",
    "fixtures:performance:dunes:dry-run": "node scripts/generate-dunes-performance-fixtures.js --dry-run",
    "fixtures:performance:realistic": "node scripts/generate-realistic-performance-fixtures.js",
    "fixtures:performance:realistic:dry-run": "node scripts/generate-realistic-performance-fixtures.js --dry-run",
    "analyze": "ng build --configuration production --source-map=true --stats-json && webpack-bundle-analyzer dist/MicrobeTrace/stats.json",
    "predeploy": "node scripts/update-version.js",
    "deploy": "ng build --configuration production --base-href https://cdcgov.github.io/MicrobeTrace/ && npm run verify:dist && npx ngh --dir dist/MicrobeTrace",
    "predeploy_dev": "node scripts/update-version.js",
    "deploy_dev": "ng build --configuration production --base-href https://mossy426.github.io/MicrobeTrace/ && npm run verify:dist && npx ngh --dir dist/MicrobeTrace --repo https://github.com/mossy426/MicrobeTrace",
    "archive": "tar --exclude=.angular --exclude=dist --exclude=node_modules --exclude=node_modules_dev --exclude=.git --exclude=MicrobeTrace.tar.gz --exclude=MicrobeTrace.zip -czf MicrobeTrace.tar.gz . && powershell -Command \"$exclude = @('node_modules', 'node_modules_dev', 'dist', '.angular', '.git', 'MicrobeTrace.tar.gz', 'MicrobeTrace.zip'); $items = Get-ChildItem -Path . -Force | Where-Object { $exclude -notcontains $_.Name }; Compress-Archive -Path ($items | ForEach-Object { $_.FullName }) -DestinationPath MicrobeTrace.zip -Force\""
  },
  "browser": {
    "image-size": false
  },
  "resolutions": {
    "webpack": "^5.0.0"
  },
  "private": true,
